<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
    <kcfgfile name=""/>
    <group name="General">
        <entry name="brokerHost" type="String">
            <default></default>
        </entry>
        <entry name="brokerPort" type="Int">
            <default>1883</default>
        </entry>
        <entry name="brokerUser" type="String">
            <default></default>
        </entry>
        <entry name="brokerPassword" type="String">
            <default></default>
        </entry>
        <entry name="useTls" type="Bool">
            <default>false</default>
        </entry>
        <entry name="caFile" type="String">
            <default></default>
        </entry>
        <entry name="topicPrefix" type="String">
            <default>teslamate/cars/1</default>
        </entry>
        <!-- No longer shown. Only the one-time unit migration in main.qml reads it. -->
        <entry name="imperial" type="Bool">
            <default>true</default>
        </entry>
        <!-- 0 follows the locale, 1 km, 2 mi. Speed uses the same unit. -->
        <entry name="distanceUnit" type="Int">
            <default>0</default>
        </entry>
        <!-- 0 follows the locale, 1 °C, 2 °F. -->
        <entry name="temperatureUnit" type="Int">
            <default>0</default>
        </entry>
        <!-- 0 follows the locale, 1 bar, 2 psi, 3 kPa. -->
        <entry name="pressureUnit" type="Int">
            <default>0</default>
        </entry>
        <!-- Not shown. main.qml sets it once the units above have been migrated. -->
        <entry name="unitsMigrated" type="Bool">
            <default>false</default>
        </entry>
        <entry name="rangeType" type="Int">
            <default>0</default>
        </entry>
        <entry name="refreshSeconds" type="Int">
            <default>15</default>
        </entry>
        <!-- Whether the panel shows any text next to the icon. The name is from when it
             could only show the percentage. -->
        <entry name="showPanelPercentage" type="Bool">
            <default>true</default>
        </entry>
        <!-- 0 percentage, 1 range, 2 both. -->
        <entry name="panelText" type="Int">
            <default>0</default>
        </entry>
        <entry name="panelChargingTime" type="Bool">
            <default>false</default>
        </entry>
        <entry name="rightHandDrive" type="Bool">
            <default>false</default>
        </entry>
        <!-- TeslaMate geofence names, separated by commas, where an unlocked car is fine. -->
        <entry name="unlockedOkGeofences" type="String">
            <default></default>
        </entry>
    </group>
</kcfg>
