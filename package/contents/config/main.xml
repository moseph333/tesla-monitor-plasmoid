<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
    <kcfgfile name=""/>
    <group name="General">
        <!-- Where the data comes from: 0 TeslaMate over MQTT, 1 the Tesla Fleet API, 2 the
             TeslaMate API (see sources.js). -->
        <entry name="dataSource" type="Int">
            <default>0</default>
        </entry>
        <!-- Tesla Fleet API. apiRegion 0 North America and Asia-Pacific, 1 Europe, Middle
             East and Africa, 2 China, 3 the custom apiBaseUrl (for proxies). -->
        <entry name="apiRegion" type="Int">
            <default>0</default>
        </entry>
        <entry name="apiBaseUrl" type="String">
            <default></default>
        </entry>
        <entry name="apiVin" type="String">
            <default></default>
        </entry>
        <!-- The widget replaces these three when it renews the access token. -->
        <entry name="apiAccessToken" type="String">
            <default></default>
        </entry>
        <entry name="apiRefreshToken" type="String">
            <default></default>
        </entry>
        <!-- When apiAccessToken expires, in milliseconds since 1970. 0 is unknown. -->
        <entry name="apiTokenExpiry" type="Double">
            <default>0</default>
        </entry>
        <!-- The client ID of the Fleet API app the tokens were issued to. Needed to renew. -->
        <entry name="apiClientId" type="String">
            <default></default>
        </entry>
        <!-- Empty means Tesla's token server. -->
        <entry name="apiAuthUrl" type="String">
            <default></default>
        </entry>
        <!-- Each request is billed, so the API polls far less often than MQTT. The widget
             never polls the API more than once a minute. -->
        <entry name="apiRefreshSeconds" type="Int">
            <default>300</default>
        </entry>
        <entry name="apiIdleRefreshSeconds" type="Int">
            <default>900</default>
        </entry>
        <!-- TeslaMate API (TeslaMateApi): its address, the API_TOKEN it may be set up with,
             and TeslaMate's ID for the car. -->
        <entry name="teslamateApiUrl" type="String">
            <default></default>
        </entry>
        <entry name="teslamateApiToken" type="String">
            <default></default>
        </entry>
        <entry name="teslamateApiCarId" type="Int">
            <default>1</default>
        </entry>
        <entry name="brokerHost" type="String">
            <default></default>
        </entry>
        <entry name="brokerPort" type="Int">
            <default>1883</default>
        </entry>
        <entry name="brokerUser" type="String">
            <default></default>
        </entry>
        <entry name="brokerPassword" type="String">
            <default></default>
        </entry>
        <entry name="useTls" type="Bool">
            <default>false</default>
        </entry>
        <entry name="caFile" type="String">
            <default></default>
        </entry>
        <entry name="topicPrefix" type="String">
            <default>teslamate/cars/1</default>
        </entry>
        <!-- No longer shown. Only the one-time unit migration in main.qml reads it. -->
        <entry name="imperial" type="Bool">
            <default>true</default>
        </entry>
        <!-- 0 follows the locale, 1 km, 2 mi. Speed uses the same unit. -->
        <entry name="distanceUnit" type="Int">
            <default>0</default>
        </entry>
        <!-- 0 follows the locale, 1 °C, 2 °F. -->
        <entry name="temperatureUnit" type="Int">
            <default>0</default>
        </entry>
        <!-- 0 follows the locale, 1 bar, 2 psi, 3 kPa. -->
        <entry name="pressureUnit" type="Int">
            <default>0</default>
        </entry>
        <!-- Not shown. main.qml sets it once the units above have been migrated. -->
        <entry name="unitsMigrated" type="Bool">
            <default>false</default>
        </entry>
        <entry name="rangeType" type="Int">
            <default>0</default>
        </entry>
        <entry name="refreshSeconds" type="Int">
            <default>15</default>
        </entry>
        <!-- Seconds between polls while the car sleeps and the popup is closed. The widget
             never polls faster than refreshSeconds. -->
        <entry name="idleRefreshSeconds" type="Int">
            <default>120</default>
        </entry>
        <!-- Whether the panel shows any text next to the icon. The name is from when it
             could only show the percentage. -->
        <entry name="showPanelPercentage" type="Bool">
            <default>true</default>
        </entry>
        <!-- 0 percentage, 1 range, 2 both. -->
        <entry name="panelText" type="Int">
            <default>0</default>
        </entry>
        <entry name="panelChargingTime" type="Bool">
            <default>false</default>
        </entry>
        <entry name="rightHandDrive" type="Bool">
            <default>false</default>
        </entry>
        <!-- Which car the panel icon and the card draw: 0 the model TeslaMate reports,
             1 Model S, 2 Model 3, 3 Model X, 4 Model Y, 5 Cybertruck. -->
        <entry name="carModel" type="Int">
            <default>0</default>
        </entry>
        <!-- 0 the car's own paint, as TeslaMate reports it, 1 theme colors. -->
        <entry name="carColor" type="Int">
            <default>0</default>
        </entry>
        <!-- Off by default, since the route names where the car is going. -->
        <entry name="showNavigation" type="Bool">
            <default>false</default>
        </entry>
        <!-- TeslaMate geofence names, separated by commas, where an unlocked car is fine. -->
        <entry name="unlockedOkGeofences" type="String">
            <default></default>
        </entry>
        <!-- TeslaMate's web address, which the car's name and the context menu open. Empty
             means no link. -->
        <entry name="teslamateUrl" type="String">
            <default></default>
        </entry>
        <!-- Desktop notifications. notifyChargeStopped also covers a charger that loses
             power during a charge. -->
        <entry name="notifyChargeComplete" type="Bool">
            <default>true</default>
        </entry>
        <entry name="notifyChargeStopped" type="Bool">
            <default>true</default>
        </entry>
        <entry name="notifyLeftOpen" type="Bool">
            <default>true</default>
        </entry>
        <entry name="notifyUnlocked" type="Bool">
            <default>true</default>
        </entry>
        <!-- Minutes something stays open, or the car unlocked with nobody inside, before it
             notifies. 1 to 120. -->
        <entry name="leftOpenMinutes" type="Int">
            <default>10</default>
        </entry>
        <entry name="notifyTires" type="Bool">
            <default>true</default>
        </entry>
        <entry name="notifyUpdates" type="Bool">
            <default>true</default>
        </entry>
    </group>
</kcfg>
